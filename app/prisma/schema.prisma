generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accountStatus       String    @default("PENDING")
  forcePasswordChange Boolean   @default(false)
  passwordHash        String?
  role                String    @default("PLAYER")
  aiPreferences       Json?
  apiKeys             Json?
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  usageStats          Json?
  apiEnabled          Json?
  customThemes        Json?
  activeThemeId       String?   @default("default")
  journeys            Journey[]
  notices             PlayerNotice[]
}

model Journey {
  id              String   @id @default(cuid())
  playerId        String
  genre           String
  status          String   @default("active")
  history         Json
  flags           Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  memories        Json?
  settings        Json?
  lastPdfUrl      String?
  lastPdfHash     String?
  lastTextPdfUrl  String?
  lastTextPdfHash String?
  playerStatus    Json?
  playerInventory Json?
  finalStatus     Json?
  finalInventory   Json?
  finalSkills     Json?
  finalStatusHistory Json?
  finalNotifications Json?
  assets          Asset[]
  player          Player   @relation(fields: [playerId], references: [id])
  scenes          Scene[]
  shareLinks      JourneyShareLink[]
}

model Scene {
  id                String   @id @default(cuid())
  journeyId         String
  sceneId           String
  order             Int
  narration         String
  visualDescription String
  audioDescription  String?
  imageUrl          String?
  audioUrl          String?
  options           Json?
  tacticalOptions   Json?
  puzzle            Json?
  selectedOption    String?
  statusChanges     Json?
  inventoryChanges  Json?
  skillChanges      Json?
  worldUpdate       Json?
  isGameOver        Boolean  @default(false)
  createdAt         DateTime @default(now())
  journey           Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([order])
}

model Asset {
  id        String   @id @default(cuid())
  journeyId String
  url       String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  journey   Journey  @relation(fields: [journeyId], references: [id])
}

model JourneyShareLink {
  id               String    @id @default(cuid())
  journeyId        String
  shareTokenHash   String    @unique
  sessionTokenHash String?   @unique
  createdAt        DateTime  @default(now())
  redeemExpiresAt  DateTime
  redeemedAt       DateTime?
  sessionExpiresAt DateTime?
  journey          Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
}

// Singleton (id fixo "global") — sempre uma única linha, atualizada in-place pelo admin.
model Announcement {
  id        String   @id
  message   String
  variant   String   @default("info") // 'info' | 'warning' | 'critical'
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Aviso individual (admin -> um jogador específico), diferente do Announcement global:
// cada envio é sua própria linha, com leitura rastreada por jogador.
model PlayerNotice {
  id        String    @id @default(cuid())
  playerId  String
  message   String
  variant   String    @default("info") // 'info' | 'warning' | 'critical'
  createdAt DateTime  @default(now())
  readAt    DateTime?
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// Singleton (id fixo "global") — só o conteúdo seguro do prompt narrativo (persona,
// magnitude, diretrizes extras). As regras ligadas aos nomes de campo do sceneSchema
// (dado, puzzle, combate, mundo) continuam fixas em código, fora deste editor.
model NarrativeConfig {
  id              String   @id
  persona         String
  detailShort     String
  detailMedium    String
  detailLong      String
  detailEpic      String
  extraDirectives String?
  updatedAt       DateTime @updatedAt
}

// Trilha de ações administrativas (quem, o quê, quando, em qual jogador).
// targetPlayerId NÃO é uma foreign key de propósito: um banimento (Player.delete)
// apaga a linha do Player, mas o registro de auditoria desse banimento precisa
// sobreviver — daí targetPlayerName ser uma cópia (snapshot) do nome no momento da ação.
model AuditLog {
  id               String   @id @default(cuid())
  actorId          String
  actorName        String
  action           String
  targetPlayerId   String?
  targetPlayerName String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([targetPlayerId])
}

// Singleton (id fixo "global") — liga/desliga a tela de manutenção pra quem não é
// ADMIN. Nunca mexe no processo Next.js em si: o app continua rodando o tempo todo,
// só muda o que renderiza pro jogador comum enquanto isso estiver ativo.
model MaintenanceMode {
  id        String   @id
  isActive  Boolean  @default(false)
  message   String?
  updatedAt DateTime @updatedAt
}
